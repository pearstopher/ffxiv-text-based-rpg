<?xml version="1.0" encoding="utf-8"?>
<!-- The Dalamud.NET.Sdk version is pinned in global.json (msbuild-sdks). -->
<Project Sdk="Dalamud.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\TextBasedRPG.Core\TextBasedRPG.Core.csproj" />
    <!-- Dalamud's own localization library (ships with Dalamud, so not copied). -->
    <Reference Include="CheapLoc" Private="false" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyName>TextBasedRPG</AssemblyName>
    <RootNamespace>TextBasedRPG</RootNamespace>
    <!-- The plugin version. Bump it in the release commit; release.yml fails if the tag doesn't match (v1.2.3 -> 1.2.3.0). -->
    <Version>1.0.3.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager) -->
    <Author>Ane Mora</Author>
    <Name>Text-Only Mode</Name>
    <Punchline>Turn off the graphics, keep the chat. A low-CPU chat-only mode.</Punchline>
    <!-- &#10;&#10; puts a blank line in the plugin installer. -->
    <Description>Turns FFXIV into a text-based RPG. Type /trpg and the 3D world and the whole HUD disappear: only the chat window stays, and the frame rate drops, so the game barely uses your CPU while you're just chatting with friends.&#10;&#10;Your connection stays alive, you can keep talking in every chat channel, and sound keeps playing. Type /trpg again to go back to playing.</Description>
    <RepoUrl>https://github.com/pearstopher/ffxiv-text-based-rpg</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/pearstopher/ffxiv-text-based-rpg/master/images/icon.png</IconUrl>
    <Tags>chat;performance;cpu;fps;render;low power;afk;idle</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin icon: 512x512 square PNG (generated by images/make_icon.py). Dalamud shows a dev plugin's icon from images/icon.png next to its DLL. -->
    <Content Include="..\images\icon.png" Link="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- Language files (en.json and, later, ja/de/fr...): copied next to the DLL and into the release zip. -->
    <Content Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
