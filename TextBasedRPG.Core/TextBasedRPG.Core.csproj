<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic with no Dalamud or game references, so it can be unit-tested. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- English text: one file, shared with the plugin's Localization folder (other languages are loaded from there at run time). -->
  <ItemGroup>
    <EmbeddedResource Include="..\TextBasedRPG\Localization\en.json" LogicalName="en.json" />
  </ItemGroup>

</Project>
